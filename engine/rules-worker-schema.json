{
  "type": "object",
  "properties": {
    "findings": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "file": { "type": "string", "maxLength": 2000 },
          "line": { "type": "integer", "minimum": 1 },
          "severity": { "type": "string", "maxLength": 2000, "enum": ["P2", "P3"] },
          "rule_source": { "type": "string", "maxLength": 2000 },
          "change": { "type": "string", "maxLength": 2000 },
          "violation": { "type": "string", "maxLength": 2000 }
        },
        "required": ["title", "file", "line", "severity", "rule_source", "change", "violation"],
        "additionalProperties": false
      }
    },
    "files_read": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 2000 } }
  },
  "required": ["findings", "files_read"],
  "additionalProperties": false
}
